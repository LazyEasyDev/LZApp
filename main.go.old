package main

import (
	"context"
	"crypto/sha256"
	"crypto/subtle"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"strings"
	"sync"
	"syscall"
	"time"

	"github.com/danielgtaylor/huma/v2"
	"github.com/danielgtaylor/huma/v2/adapters/humachi"
	"github.com/go-chi/chi/v5"
	chimiddleware "github.com/go-chi/chi/v5/middleware"
	"github.com/go-chi/jwtauth/v5"
	"github.com/lestrrat-go/jwx/v3/jwt"
)

const (
	jwtAudience        = "lzapp-api"
	jwtIssuer          = "lzapp"
	jwtTokenTTL        = time.Hour
	minJWTSecretLength = 32
)

type authService struct {
	tokenAuth    *jwtauth.JWTAuth
	username     string
	usernameHash [sha256.Size]byte
	passwordHash [sha256.Size]byte
}

func newAuthService(secret, username, password string) (*authService, error) {
	if len(secret) < minJWTSecretLength {
		return nil, fmt.Errorf("JWT_SECRET must contain at least %d bytes", minJWTSecretLength)
	}
	if username == "" {
		return nil, errors.New("AUTH_USERNAME is required")
	}
	if password == "" {
		return nil, errors.New("AUTH_PASSWORD is required")
	}

	return &authService{
		tokenAuth: jwtauth.New(
			"HS256",
			[]byte(secret),
			nil,
			jwt.WithIssuer(jwtIssuer),
			jwt.WithAudience(jwtAudience),
		),
		username:     username,
		usernameHash: sha256.Sum256([]byte(username)),
		passwordHash: sha256.Sum256([]byte(password)),
	}, nil
}

func (auth *authService) validCredentials(username, password string) bool {
	usernameHash := sha256.Sum256([]byte(username))
	passwordHash := sha256.Sum256([]byte(password))
	usernameMatches := subtle.ConstantTimeCompare(usernameHash[:], auth.usernameHash[:])
	passwordMatches := subtle.ConstantTimeCompare(passwordHash[:], auth.passwordHash[:])
	return usernameMatches&passwordMatches == 1
}

func (auth *authService) issueToken(subject string) (string, error) {
	now := time.Now().UTC()
	_, token, err := auth.tokenAuth.Encode(map[string]any{
		"aud": []string{jwtAudience},
		"exp": now.Add(jwtTokenTTL).Unix(),
		"iat": now.Unix(),
		"iss": jwtIssuer,
		"nbf": now.Unix(),
		"sub": subject,
	})
	return token, err
}

func operationRequiresBearer(operation *huma.Operation) bool {
	if operation == nil {
		return false
	}
	for _, requirement := range operation.Security {
		if _, ok := requirement["bearer"]; ok {
			return true
		}
	}
	return false
}

func (auth *authService) middleware(api huma.API) func(huma.Context, func(huma.Context)) {
	return func(ctx huma.Context, next func(huma.Context)) {
		if !operationRequiresBearer(ctx.Operation()) {
			next(ctx)
			return
		}

		scheme, tokenString, found := strings.Cut(ctx.Header("Authorization"), " ")
		if !found || !strings.EqualFold(scheme, "Bearer") || strings.TrimSpace(tokenString) == "" {
			ctx.SetHeader("WWW-Authenticate", `Bearer realm="LZApp API"`)
			huma.WriteErr(api, ctx, http.StatusUnauthorized, "missing or invalid bearer token")
			return
		}

		token, err := jwtauth.VerifyToken(auth.tokenAuth, strings.TrimSpace(tokenString))
		if err != nil || token == nil {
			ctx.SetHeader("WWW-Authenticate", `Bearer realm="LZApp API"`)
			huma.WriteErr(api, ctx, http.StatusUnauthorized, "missing or invalid bearer token")
			return
		}

		requestContext := jwtauth.NewContext(ctx.Context(), token, nil)
		next(huma.WithContext(ctx, requestContext))
	}
}

type User struct {
	ID    int64  `json:"id"`
	Name  string `json:"name"`
	Email string `json:"email,omitempty" format:"email"`
}

type userStore struct {
	mu     sync.RWMutex
	nextID int64
	users  map[int64]User
}

func newUserStore() *userStore {
	return &userStore{
		nextID: 2,
		users: map[int64]User{
			1: {ID: 1, Name: "Alice", Email: "alice@example.com"},
		},
	}
}

func (store *userStore) get(id int64) (User, bool) {
	store.mu.RLock()
	defer store.mu.RUnlock()
	user, ok := store.users[id]
	return user, ok
}

func (store *userStore) create(name, email string) User {
	store.mu.Lock()
	defer store.mu.Unlock()

	user := User{ID: store.nextID, Name: name, Email: email}
	store.users[user.ID] = user
	store.nextID++
	return user
}

type GetUserInput struct {
	ID           int64 `path:"id" minimum:"1"`
	IncludeEmail bool  `query:"include_email" doc:"Include the user's email address"`
}

type GetUserOutput struct {
	RequestID string `header:"X-Request-ID"`
	Body      User
}

type CreateUserInput struct {
	Body struct {
		Name  string `json:"name" minLength:"1" maxLength:"100" example:"Jane Doe"`
		Email string `json:"email" format:"email" example:"jane@example.com"`
	}
}

type CreateUserOutput struct {
	Location string `header:"Location"`
	Body     User
}

type CreateTokenInput struct {
	Body struct {
		Username string `json:"username" minLength:"1"`
		Password string `json:"password" minLength:"1"`
	}
}

type CreateTokenOutput struct {
	Body struct {
		AccessToken string `json:"access_token"`
		TokenType   string `json:"token_type"`
		ExpiresIn   int64  `json:"expires_in"`
	}
}

func newRouter(store *userStore, auth *authService) http.Handler {
	router := chi.NewRouter()
	router.Use(chimiddleware.RequestID)
	router.Use(chimiddleware.Recoverer)

	router.Get("/healthz", func(response http.ResponseWriter, _ *http.Request) {
		response.Header().Set("Content-Type", "text/plain; charset=utf-8")
		_, _ = response.Write([]byte("ok"))
	})

	config := huma.DefaultConfig("LZApp API", "1.0.0")
	config.DocsRenderer = huma.DocsRendererScalar

	config.Components.SecuritySchemes = map[string]*huma.SecurityScheme{
		"bearer": {
			Type:         "http",
			Scheme:       "bearer",
			BearerFormat: "JWT",
		},
	}

	api := humachi.New(router, config)
	api.UseMiddleware(auth.middleware(api))

	//v1 := huma.NewGroup(api, "/v1")

	huma.Register(api, huma.Operation{
		OperationID: "create-token",
		Method:      http.MethodPost,
		Path:        "/auth/token",
		Summary:     "Create an access token",
		Errors:      []int{http.StatusUnauthorized},
	}, func(_ context.Context, input *CreateTokenInput) (*CreateTokenOutput, error) {
		if !auth.validCredentials(input.Body.Username, input.Body.Password) {
			return nil, huma.Error401Unauthorized("invalid credentials")
		}

		token, err := auth.issueToken(auth.username)
		if err != nil {
			return nil, huma.Error500InternalServerError("failed to issue access token")
		}

		output := &CreateTokenOutput{}
		output.Body.AccessToken = token
		output.Body.TokenType = "Bearer"
		output.Body.ExpiresIn = int64(jwtTokenTTL.Seconds())
		return output, nil
	})

	huma.Register(api, huma.Operation{
		OperationID: "get-user",
		Method:      http.MethodGet,
		Path:        "/users/{id}",
		Summary:     "Get a user",
		Errors:      []int{http.StatusUnauthorized},
		Security: []map[string][]string{
			{"bearer": {}},
		},
	}, func(ctx context.Context, input *GetUserInput) (*GetUserOutput, error) {
		user, ok := store.get(input.ID)
		if !ok {
			return nil, huma.Error404NotFound("user not found")
		}
		if !input.IncludeEmail {
			user.Email = ""
		}

		return &GetUserOutput{
			RequestID: chimiddleware.GetReqID(ctx),
			Body:      user,
		}, nil
	})

	huma.Register(api, huma.Operation{
		OperationID: "create-user",
		Method:      http.MethodPost,
		Path:        "/users/create",
		Summary:     "Create a user xxx",
		Errors:      []int{http.StatusUnauthorized},
		Security: []map[string][]string{
			{"bearer": {}},
		},
	}, func(_ context.Context, input *CreateUserInput) (*CreateUserOutput, error) {
		user := store.create(input.Body.Name, input.Body.Email)
		return &CreateUserOutput{
			Location: fmt.Sprintf("/v1/users/%d", user.ID),
			Body:     user,
		}, nil
	})

	return router
}

func main() {
	auth, err := newAuthService(
		"dweqewdadadweqewdadadweqewdada23",
		"admin",
		"admin",
		//os.Getenv("JWT_SECRET"),
		//os.Getenv("AUTH_USERNAME"),
		//os.Getenv("AUTH_PASSWORD"),
	)
	if err != nil {
		slog.Error("invalid authentication configuration", "error", err)
		os.Exit(1)
	}

	address := ":8080"
	if port := os.Getenv("PORT"); port != "" {
		address = ":" + port
	}

	server := &http.Server{
		Addr:              address,
		Handler:           newRouter(newUserStore(), auth),
		ReadHeaderTimeout: 5 * time.Second,
	}

	shutdownSignal, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	go func() {
		<-shutdownSignal.Done()
		shutdownContext, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		if err := server.Shutdown(shutdownContext); err != nil {
			slog.Error("server shutdown failed", "error", err)
		}
	}()

	slog.Info("server listening", "address", address, "docs", "http://localhost"+address+"/docs")
	if err := server.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
		slog.Error("server failed", "error", err)
		os.Exit(1)
	}
}
